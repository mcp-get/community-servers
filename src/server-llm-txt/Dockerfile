FROM node:lts-alpine

# Create app directory
WORKDIR /app

# Copy necessary files from repository root (the monorepo) into Docker context
COPY package.json ./
COPY tsconfig.json ./

# Copy the server source folder
COPY src/server-llm-txt/ ./

# Install dependencies (skip scripts if needed)
RUN npm install --ignore-scripts

# Build the project
RUN npm run build

EXPOSE 8080

CMD [ "node", "dist/index.js" ]
